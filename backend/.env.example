# Bhumi Survey 3D Backend - Environment Variables
# Copy this file to .env and fill in real values

# Database (Render provides this automatically when you add PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/bhumi3d

# JWT secret (generate a random 64-char string)
JWT_SECRET=change-me-to-a-random-64-character-string

# App secret
SECRET_KEY=change-me-to-any-random-string

# CORS - comma separated list of allowed origins
CORS_ORIGINS=https://frontend-pied-nine-61.vercel.app,http://localhost:5173

# Upload directory
UPLOAD_DIRECTORY=/app/uploads